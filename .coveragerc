# Coverage config for PyDeepGP
#
# Measured surface is the maintained serial DeepGP path. The omitted modules
# are known gaps (MPI, MRD, prediction-only SVI ratio) and are tracked as
# follow-up work rather than counted against the CI gate (CIP-0001).
[run]
branch = True
source = deepgp
omit =
    */deepgp/testing/*
    */deepgp/layers/mrd.py
    */deepgp/inference/vardtc_parallel.py
    */deepgp/inference/inferenceX.py
    */deepgp/inference/svi_ratio.py
    */deepgp/util/parallel.py

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    raise
    except
    pass
    if __name__ == .__main__.:
    if 0:
ignore_errors = True
show_missing = True

[html]
directory = htmlcov
